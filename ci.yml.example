name: CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    container:
      image: archlinux:latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install build dependencies
        run: |
          pacman -Syu --noconfirm base-devel git pciutils

      - name: Configure non-root build user
        run: |
          useradd -m builder
          echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
          chown -R builder:builder .

      - name: Verify .SRCINFO consistency
        run: |
          su builder -c "makepkg --printsrcinfo > .SRCINFO.gen"
          diff -u .SRCINFO .SRCINFO.gen || {
            echo "ERROR: .SRCINFO is out of sync with PKGBUILD! Run 'makepkg --printsrcinfo > .SRCINFO' and commit."
            exit 1
          }

      - name: Test package build (makepkg)
        run: |
          su builder -c "makepkg -cf --nodeps"

      - name: Verify package contents
        run: |
          tar -tvf limine-vfio-*.pkg.tar.zst
