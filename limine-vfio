#!/usr/bin/env bash
# ==============================================================================
# limine-vfio: Interactive Device Passthrough Manager for Limine Bootloader
# ==============================================================================
# Supports hardware diagnostics, device classification, IOMMU grouping checks,
# dynamic Limine boot entry generation, and driver exclusion configuration.
# Works for any PCI device (GPU, Network, USB, Audio, Storage, Accelerators).
# ==============================================================================

set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="/etc/vfio-passthrough.d"
GLOBAL_CONFIG="/etc/vfio-passthrough.conf"
LIMINE_DEFAULT="/etc/default/limine"
HOOK_TARGET="/etc/boot/hooks/post.d/95-vfio-entries"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Color formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

msg_info()    { echo -e "${BLUE}${BOLD}[INFO]${RESET} $*"; }
msg_ok()      { echo -e "${GREEN}${BOLD}[OK]${RESET} $*"; }
msg_warn()    { echo -e "${YELLOW}${BOLD}[WARN]${RESET} $*"; }
msg_err()     { echo -e "${RED}${BOLD}[ERROR]${RESET} $*" >&2; }
msg_header()  { echo -e "\n${BOLD}${CYAN}=== $* ===${RESET}"; }

check_root() {
    if [[ $EUID -ne 0 ]]; then
        msg_err "This operation requires root privileges. Please re-run with sudo."
        exit 1
    fi
}

# ==============================================================================
# Device Classification Helper
# ==============================================================================
classify_device() {
    local pci_class="$1"
    case "$pci_class" in
        *"VGA"*|*"3D controller"*|*"Display controller"*)
            echo "GPU"
            ;;
        *"Audio device"*)
            echo "AUDIO"
            ;;
        *"Ethernet controller"*|*"Network controller"*)
            echo "NETWORK"
            ;;
        *"USB controller"*)
            echo "USB"
            ;;
        *"Non-Volatile memory"*|*"SATA controller"*)
            echo "STORAGE"
            ;;
        *"Capture"*|*"Video"*)
            echo "CAPTURE"
            ;;
        *"Encryption controller"*|*"Processing accelerators"*)
            echo "ACCELERATOR"
            ;;
        *"Host bridge"*|*"PCI bridge"*|*"IOMMU"*|*"ISA bridge"*|*"Root Complex"*|*"SMBus"*|*"Instrumentation"*)
            echo "SYSTEM"
            ;;
        *)
            echo "OTHER"
            ;;
    esac
}

get_type_color() {
    local dev_type="$1"
    case "$dev_type" in
        GPU)         echo "${GREEN}${BOLD}" ;;
        NETWORK)     echo "${BLUE}${BOLD}" ;;
        USB)         echo "${YELLOW}${BOLD}" ;;
        AUDIO)       echo "${CYAN}" ;;
        STORAGE)     echo "${MAGENTA}${BOLD}" ;;
        CAPTURE)     echo "${CYAN}${BOLD}" ;;
        ACCELERATOR) echo "${MAGENTA}" ;;
        *)           echo "${RESET}" ;;
    esac
}

# ==============================================================================
# Pre-Flight Diagnostics
# ==============================================================================
cmd_check() {
    msg_header "System Architecture & VFIO Readiness Check"
    local has_errors=0

    # 1. CPU Virtualization
    echo -n "Checking CPU virtualization support: "
    if grep -q -E '(vmx|svm)' /proc/cpuinfo; then
        local cpu_type="Unknown"
        grep -q 'svm' /proc/cpuinfo && cpu_type="AMD (AMD-V / SVM)"
        grep -q 'vmx' /proc/cpuinfo && cpu_type="Intel (VT-x / VMX)"
        msg_ok "Supported: ${cpu_type}"
    else
        msg_err "Hardware virtualization (VT-x / AMD-V) is not detected or disabled in BIOS!"
        has_errors=1
    fi

    # 2. IOMMU Kernel Support
    echo -n "Checking IOMMU kernel status: "
    if [[ -d /sys/kernel/iommu_groups && $(ls -A /sys/kernel/iommu_groups 2>/dev/null) ]]; then
        local group_count
        group_count=$(find /sys/kernel/iommu_groups/ -maxdepth 1 -mindepth 1 -type d | wc -l)
        msg_ok "Active (${group_count} IOMMU groups detected)"
    else
        msg_warn "IOMMU is not active in current boot session. Ensure 'amd_iommu=on' or 'intel_iommu=on' and 'iommu=pt' are in kernel cmdline."
    fi

    # 3. Current Boot Parameters
    echo -n "Checking current kernel cmdline: "
    if grep -q 'vfio-pci.ids' /proc/cmdline; then
        local vfio_ids
        vfio_ids=$(grep -o 'vfio-pci\.ids=[^ ]*' /proc/cmdline)
        msg_ok "Active passthrough: ${vfio_ids}"
    else
        msg_info "Standard host boot (no vfio-pci.ids active in running kernel)"
    fi

    # 4. Initramfs Modules
    echo -n "Checking /etc/mkinitcpio.conf modules: "
    if [[ -f /etc/mkinitcpio.conf ]]; then
        if grep -q 'vfio_pci' /etc/mkinitcpio.conf; then
            msg_ok "vfio modules detected in MODULES array"
        else
            msg_warn "vfio_pci not found in /etc/mkinitcpio.conf MODULES array. Early driver binding may fail."
        fi
    else
        msg_warn "/etc/mkinitcpio.conf not found."
    fi

    # 5. Bootloader & Limine
    echo -n "Checking Limine bootloader tools: "
    if command -v limine-entry-tool &>/dev/null; then
        msg_ok "limine-entry-tool installed"
    else
        msg_err "limine-entry-tool not found. Ensure limine-mkinitcpio-hook or limine-entry-tool is installed."
        has_errors=1
    fi

    # 6. Post-hook Installation
    echo -n "Checking Limine automation hook: "
    if [[ -x "$HOOK_TARGET" ]]; then
        msg_ok "Installed at ${HOOK_TARGET}"
    else
        msg_warn "Hook not installed at ${HOOK_TARGET}. Run 'limine-vfio install' to deploy."
    fi

    # 7. Config Directory
    echo -n "Checking configuration profiles directory: "
    if [[ -d "$CONFIG_DIR" ]]; then
        local conf_count
        conf_count=$(find "$CONFIG_DIR" -name "*.conf" | wc -l)
        msg_ok "${CONFIG_DIR} exists (${conf_count} profiles configured)"
    else
        msg_info "${CONFIG_DIR} does not exist yet. Run 'limine-vfio install' or 'limine-vfio add' to configure."
    fi

    # 8. Boot Configuration & Conflict Check
    check_conflicts "${1:-no}"

    echo ""
    if ((has_errors == 0)); then
        msg_ok "System is ready for VFIO passthrough configuration!"
    else
        msg_err "Some prerequisites are missing. Please review the warnings above."
    fi
}

# ==============================================================================
# Conflict Detection & Resolution Assistant
# ==============================================================================
check_conflicts() {
    local auto_prompt="${1:-yes}"
    local conflicts_found=0
    local -a ORPHAN_KEYS=()
    local -a MISSING_KEYS=()
    local -a PRIMARY_GPU_PROFILES=()

    echo -n "Checking boot menu & kernel command-line conflicts: "

    # 1. Check if KERNEL_CMDLINE[default] contains vfio-pci.ids
    if [[ -f "$LIMINE_DEFAULT" ]] && grep -F "KERNEL_CMDLINE[default]" "$LIMINE_DEFAULT" 2>/dev/null | grep -q 'vfio-pci\.ids='; then
        conflicts_found=$((conflicts_found + 1))
        echo ""
        msg_err "CRITICAL: KERNEL_CMDLINE[default] in ${LIMINE_DEFAULT} contains 'vfio-pci.ids'. This isolates devices on EVERY boot, preventing standard desktop use!"
    fi

    # 2. Discover all display GPUs and Primary Display GPU (boot_vga == 1)
    local -a ALL_GPU_IDS=()
    local -a ALL_GPU_PCIS=()
    local primary_gpu_pci=""
    local primary_gpu_id=""
    for dev in /sys/bus/pci/devices/*; do
        if [[ -f "$dev/class" ]]; then
            local class_code
            class_code=$(cat "$dev/class" 2>/dev/null || true)
            if [[ "$class_code" =~ ^0x030[02] || "$class_code" =~ ^0x0380 ]]; then
                local dev_pci dev_id
                dev_pci=$(basename "$dev")
                dev_id=$(lspci -nns "$dev_pci" 2>/dev/null | grep -o '\[[0-9a-fA-F]\{4\}:[0-9a-fA-F]\{4\}\]' | tail -n 1 | tr -d '[]')
                ALL_GPU_IDS+=("$dev_id")
                ALL_GPU_PCIS+=("$dev_pci")
                if [[ -f "$dev/boot_vga" ]] && [[ $(cat "$dev/boot_vga" 2>/dev/null) == "1" ]]; then
                    primary_gpu_pci="$dev_pci"
                    primary_gpu_id="$dev_id"
                fi
            fi
        fi
    done
    local total_gpus=${#ALL_GPU_IDS[@]}
    local -a LOCKOUT_PROFILES=()
    local -a ALTERNATE_GPU_PROFILES=()

    # 3. Check profiles in /etc/vfio-passthrough.d
    declare -A ACTIVE_PROFILES=()
    if [[ -d "$CONFIG_DIR" ]]; then
        for conf in "$CONFIG_DIR"/*.conf; do
            [[ -f "$conf" ]] || continue
            local p_name="" p_enabled="yes" p_ids=""
            while IFS='=' read -r k v || [[ -n "$k" ]]; do
                k=$(echo "$k" | tr -d '[:space:]')
                v=$(echo "$v" | sed -e 's/^[[:space:]]*["'"'"']//' -e 's/["'"'"'][[:space:]]*$//')
                case "$k" in
                    PROFILE|profile) p_name="$v" ;;
                    ENABLED|enabled) p_enabled="$v" ;;
                    PCI_IDS|pci_ids) p_ids="$v" ;;
                esac
            done < "$conf"

            local bName=$(basename "$conf" .conf)
            p_name="${p_name:-$bName}"
            ACTIVE_PROFILES["$p_name"]="$p_enabled"

            # Check if enabled profile targets GPUs
            if [[ "$p_enabled" =~ ^(yes|true|1)$ ]] && ((total_gpus > 0)); then
                local isolated_gpus=0
                for g_id in "${ALL_GPU_IDS[@]}"; do
                    if [[ "$p_ids" =~ $g_id ]]; then
                        isolated_gpus=$((isolated_gpus + 1))
                    fi
                done

                if ((isolated_gpus >= total_gpus)); then
                    # All GPUs in the system are isolated: total host lockout!
                    LOCKOUT_PROFILES+=("$p_name")
                    conflicts_found=$((conflicts_found + 1))
                elif [[ -n "$primary_gpu_id" && "$p_ids" =~ $primary_gpu_id ]]; then
                    # Primary GPU isolated, but another GPU exists for host display
                    ALTERNATE_GPU_PROFILES+=("$p_name")
                fi
            fi

            # Check if enabled profile has corresponding KERNEL_CMDLINE entries for installed kernels
            if [[ "$p_enabled" =~ ^(yes|true|1)$ && -f "$LIMINE_DEFAULT" ]]; then
                for kDir in /usr/lib/modules/*; do
                    [[ -f "${kDir}/pkgbase" ]] || continue
                    local kName=$(cat "${kDir}/pkgbase" | tr -d '[:space:]')
                    local expected_key="KERNEL_CMDLINE[${kName}-vfio-${p_name}]"
                    if ! grep -F -q "${expected_key}=" "$LIMINE_DEFAULT" 2>/dev/null; then
                        MISSING_KEYS+=("${kName}|${p_name}|${p_ids}")
                        conflicts_found=$((conflicts_found + 1))
                    fi
                done
            fi
        done
    fi

    # 4. Check for orphan KERNEL_CMDLINE entries in /etc/default/limine
    if [[ -f "$LIMINE_DEFAULT" ]]; then
        while IFS= read -r line; do
            local key=$(echo "$line" | cut -d'=' -f1)
            if [[ "$key" =~ ^KERNEL_CMDLINE\[(.*)-vfio-(.*)\]$ ]]; then
                local k_target="${BASH_REMATCH[1]}"
                local p_target="${BASH_REMATCH[2]}"
                if [[ -z "${ACTIVE_PROFILES[$p_target]:-}" ]]; then
                    ORPHAN_KEYS+=("$key")
                    conflicts_found=$((conflicts_found + 1))
                fi
            fi
        done < <(grep -E '^KERNEL_CMDLINE\[.*-vfio-.*\]=' "$LIMINE_DEFAULT" 2>/dev/null || true)
    fi

    if ((conflicts_found == 0)); then
        msg_ok "No conflicts detected in Limine boot configuration."
        for p in "${ALTERNATE_GPU_PROFILES[@]}"; do
            echo "  * [INFO] Multi-GPU Profile '${p}' isolates primary boot GPU (${primary_gpu_pci}). Secondary GPU will serve host display."
        done
        return 0
    fi

    echo ""
    msg_warn "Detected ${conflicts_found} potential configuration conflict(s):"

    for p in "${LOCKOUT_PROFILES[@]}"; do
        msg_err "  * Profile '${p}' isolates ALL available display GPUs in system (${total_gpus}/${total_gpus})."
        echo "    -> Booting into this entry will result in a black screen / no host display!"
    done

    for orph in "${ORPHAN_KEYS[@]}"; do
        msg_warn "  * Orphan boot parameter in ${LIMINE_DEFAULT}: ${orph}"
        echo "    -> Profile drop-in '${orph}' no longer exists in ${CONFIG_DIR}/."
    done

    for miss in "${MISSING_KEYS[@]}"; do
        IFS='|' read -r k_t p_t p_ids <<< "$miss"
        msg_warn "  * Missing boot parameter for installed kernel '${k_t}': KERNEL_CMDLINE[${k_t}-vfio-${p_t}]"
        echo "    -> Profile '${p_t}' is enabled but kernel '${k_t}' will boot without passthrough flags."
    done

    # If auto_prompt is 'no', do not prompt interactively (e.g. during simple check)
    if [[ "$auto_prompt" == "no" ]]; then
        echo ""
        msg_info "Run 'sudo limine-vfio doctor' to automatically resolve these conflicts."
        return 0
    fi

    echo ""
    read -rp "Would you like limine-vfio to assist in resolving these conflicts? [Y/n]: " resolve_choice
    [[ "$resolve_choice" =~ ^[Nn]$ ]] && return 0

    check_root

    # Fix 1: Lockout GPU profiles
    for p in "${LOCKOUT_PROFILES[@]}"; do
        echo ""
        read -rp "Disable profile '${p}' to prevent host display lockout? [Y/n]: " dis_choice
        if [[ ! "$dis_choice" =~ ^[Nn]$ ]]; then
            sed -i 's/^ENABLED=.*/ENABLED="no"/' "${CONFIG_DIR}/${p}.conf"
            sed -i "/-vfio-${p}\]/d" "$LIMINE_DEFAULT"
            msg_ok "Disabled profile '${p}' in ${CONFIG_DIR} and removed boot entry."
        fi
    done

    # Fix 2: Orphan keys
    for orph in "${ORPHAN_KEYS[@]}"; do
        sed -i "s|^${orph}=.*||" "$LIMINE_DEFAULT"
        sed -i '/^$/d' "$LIMINE_DEFAULT"
        msg_ok "Removed orphan parameter: ${orph}"
    done

    # Fix 3: Missing keys
    if ((${#MISSING_KEYS[@]} > 0)); then
        local raw_cmd=""
        if [[ -f /etc/kernel/cmdline ]] && [[ -s /etc/kernel/cmdline ]]; then
            raw_cmd=$(cat /etc/kernel/cmdline)
        else
            raw_cmd=$(cat /proc/cmdline)
        fi
        local b_cmd=$(echo "$raw_cmd" | sed -E 's/(amd_iommu|intel_iommu|iommu|vfio-pci\.ids)=[^ ]*//g' | sed -E 's/  +/ /g' | xargs)

        local i_opts="amd_iommu=on iommu=pt"
        grep -q "GenuineIntel" /proc/cpuinfo 2>/dev/null && i_opts="intel_iommu=on iommu=pt"

        for miss in "${MISSING_KEYS[@]}"; do
            IFS='|' read -r k_t p_t p_ids <<< "$miss"
            local full_key="KERNEL_CMDLINE[${k_t}-vfio-${p_t}]"
            local full_val="${b_cmd} ${i_opts} vfio-pci.ids=${p_ids}"
            echo "${full_key}=${full_val}" >> "$LIMINE_DEFAULT"
            msg_ok "Generated missing parameter: ${full_key}"
        done
    fi

    echo ""
    read -rp "Rebuild Limine bootloader menu now with limine-update? [Y/n]: " update_choice
    if [[ ! "$update_choice" =~ ^[Nn]$ ]]; then
        msg_info "Running limine-update..."
        limine-update
        msg_ok "Bootloader menu successfully synchronized and resolved!"
    fi
}

# ==============================================================================
# Device & IOMMU Group Discovery
# ==============================================================================
cmd_list_devices() {
    msg_header "PCI Devices & IOMMU Groups"

    if [[ ! -d /sys/kernel/iommu_groups ]]; then
        msg_err "IOMMU is disabled or not supported. Cannot inspect IOMMU groups."
        return 1
    fi

    printf "${BOLD}%-10s %-9s %-12s %-14s %-36s %-15s${RESET}\n" "SLOT" "GROUP" "TYPE" "PCI ID" "DESCRIPTION" "DRIVER"
    echo "-----------------------------------------------------------------------------------------------------"

    for group_dir in $(find /sys/kernel/iommu_groups/ -maxdepth 1 -mindepth 1 -type d | sort -V); do
        local group_num
        group_num=$(basename "$group_dir")

        for dev_path in "${group_dir}"/devices/*; do
            [[ -e "$dev_path" ]] || continue
            local pci_slot=$(basename "$dev_path")
            local short_slot="${pci_slot#0000:}"

            local lspci_info=$(lspci -nns "$pci_slot" 2>/dev/null || true)
            [[ -z "$lspci_info" ]] && continue

            local pci_class=$(lspci -s "$pci_slot" -vmm 2>/dev/null | awk -F':\t' '/^Class:/ {print $2}' || echo "Unknown")
            local dev_type=$(classify_device "$pci_class")
            local type_color=$(get_type_color "$dev_type")

            local ids=$(echo "$lspci_info" | grep -o '\[[0-9a-fA-F]\{4\}:[0-9a-fA-F]\{4\}\]' | tail -n 1 | tr -d '[]' || true)
            local desc=$(lspci -s "$pci_slot" | sed -E 's/^[0-9a-fA-F:.]+[[:space:]]+[^:]+:[[:space:]]*//')
            desc="${desc:0:36}"

            local driver=""
            if [[ -d "${dev_path}/driver" ]]; then
                driver=$(basename "$(readlink -f "${dev_path}/driver")")
            fi

            printf "${type_color}%-10s Grp %-4s [%-9s] [%s] %-36s %-15s${RESET}\n" \
                "$short_slot" "$group_num" "$dev_type" "$ids" "$desc" "${driver:-none}"
        done
    done
}

# ==============================================================================
# Status
# ==============================================================================
cmd_status() {
    msg_header "Current VFIO Passthrough Status"

    # Current Kernel & Command Line
    echo -e "${BOLD}Running Kernel:${RESET} $(uname -r)"
    echo -e "${BOLD}Kernel Cmdline:${RESET} $(cat /proc/cmdline)"
    echo ""

    # Devices Bound to vfio-pci
    msg_header "Active VFIO Driver Bindings"
    if [[ -d /sys/bus/pci/drivers/vfio-pci ]]; then
        local vfio_bound=0
        for dev in /sys/bus/pci/drivers/vfio-pci/0000:*; do
            [[ -e "$dev" ]] || continue
            local slot=$(basename "$dev")
            local desc=$(lspci -s "$slot" 2>/dev/null || true)
            echo -e "  ${GREEN}${BOLD}[BOUND]${RESET} ${desc}"
            vfio_bound=1
        done
        if ((vfio_bound == 0)); then
            msg_info "No PCI devices are currently bound to vfio-pci in this boot session."
        fi
    else
        msg_info "vfio-pci driver is not currently loaded."
    fi

    echo ""
    msg_header "Configured Passthrough Profiles (${CONFIG_DIR})"
    if [[ -d "$CONFIG_DIR" && $(ls -A "$CONFIG_DIR" 2>/dev/null) ]]; then
        for conf in "$CONFIG_DIR"/*.conf; do
            [[ -f "$conf" ]] || continue
            echo -e "\n${BOLD}Profile File:${RESET} ${conf}"
            while IFS='=' read -r key val || [[ -n "$key" ]]; do
                key=$(echo "$key" | tr -d '[:space:]')
                val=$(echo "$val" | sed -e 's/^[[:space:]]*["'"'"']//' -e 's/["'"'"'][[:space:]]*$//')
                case "$key" in
                    PROFILE|profile) echo -e "  ${BOLD}Profile Name:${RESET}  ${val}" ;;
                    DEVICE_TYPE|device_type) echo -e "  ${BOLD}Device Type:${RESET}   ${val}" ;;
                    DESCRIPTION|description) echo -e "  ${BOLD}Description:${RESET}   ${val}" ;;
                    PCI_IDS|pci_ids) echo -e "  ${BOLD}PCI IDs:${RESET}       ${val}" ;;
                    ENABLED|enabled) echo -e "  ${BOLD}Status:${RESET}        ${val}" ;;
                esac
            done < "$conf"
        done
    else
        msg_info "No drop-in profiles found in ${CONFIG_DIR}."
    fi

    echo ""
    msg_header "Limine Command Lines (${LIMINE_DEFAULT})"
    if [[ -f "$LIMINE_DEFAULT" ]]; then
        grep -E '^KERNEL_CMDLINE\[.*vfio.*\]' "$LIMINE_DEFAULT" || msg_info "No custom VFIO commandlines found in ${LIMINE_DEFAULT}."
    fi
}

# ==============================================================================
# Add Profile Wizard (With Strict Safeguards)
# ==============================================================================
cmd_add() {
    check_root
    msg_header "Add Device Passthrough Profile"

    # Safeguard 1: CPU Virtualization Check
    if ! grep -q -E '(vmx|svm)' /proc/cpuinfo; then
        msg_err "CRITICAL: Hardware CPU virtualization (AMD-V / Intel VT-x) is disabled or not supported!"
        msg_warn "Virtualization must be enabled in your UEFI/BIOS settings before devices can be passed through to guests."
        read -rp "Do you still want to proceed anyway? (Not recommended) [y/N]: " force_virt
        [[ ! "$force_virt" =~ ^[Yy]$ ]] && return 1
    fi

    # Safeguard 2: Check IOMMU status
    if [[ ! -d /sys/kernel/iommu_groups || -z $(ls -A /sys/kernel/iommu_groups 2>/dev/null) ]]; then
        msg_warn "IOMMU is currently inactive in your running session."
        msg_info "Limine boot parameters will inject IOMMU flags so it activates upon booting the passthrough option."
    fi

    echo "Scanning available PCI devices..."
    declare -a DEV_SLOTS=()
    declare -a DEV_TYPES=()
    declare -a DEV_DESCS=()
    declare -a DEV_IDS=()
    declare -a DEV_GROUPS=()

    local idx=1
    for group_dir in $(find /sys/kernel/iommu_groups/ -maxdepth 1 -mindepth 1 -type d | sort -V); do
        local group_num=$(basename "$group_dir")

        for dev_path in "${group_dir}"/devices/*; do
            [[ -e "$dev_path" ]] || continue
            local pci_slot=$(basename "$dev_path")
            local short_slot="${pci_slot#0000:}"

            local lspci_info=$(lspci -nns "$pci_slot" 2>/dev/null || true)
            [[ -z "$lspci_info" ]] && continue

            local pci_class=$(lspci -s "$pci_slot" -vmm 2>/dev/null | awk -F':\t' '/^Class:/ {print $2}' || echo "Unknown")
            local dev_type=$(classify_device "$pci_class")

            # Filter out non-passthrough system bridges and root infrastructure
            [[ "$dev_type" == "SYSTEM" ]] && continue

            local id=$(echo "$lspci_info" | grep -o '\[[0-9a-fA-F]\{4\}:[0-9a-fA-F]\{4\}\]' | tail -n 1 | tr -d '[]' || true)
            local desc=$(lspci -s "$pci_slot" | sed -E 's/^[0-9a-fA-F:.]+[[:space:]]+[^:]+:[[:space:]]*//')

            DEV_SLOTS+=("$short_slot")
            DEV_TYPES+=("$dev_type")
            DEV_DESCS+=("$desc")
            DEV_IDS+=("$id")
            DEV_GROUPS+=("$group_num")

            local type_color=$(get_type_color "$dev_type")
            echo -e "  [${BOLD}${idx}${RESET}] ${type_color}[${dev_type}]${RESET} Slot ${BOLD}${short_slot}${RESET} (IOMMU Grp ${group_num}) [${id}]: ${desc}"
            ((idx++))
        done
    done

    if ((${#DEV_SLOTS[@]} == 0)); then
        msg_err "No passthrough-eligible devices detected."
        return 1
    fi

    echo ""
    read -rp "Select a device to configure for passthrough [1-${#DEV_SLOTS[@]}]: " choice
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#DEV_SLOTS[@]})); then
        msg_err "Invalid selection."
        return 1
    fi

    local sel_idx=$((choice - 1))
    local sel_slot="${DEV_SLOTS[$sel_idx]}"
    local sel_type="${DEV_TYPES[$sel_idx]}"
    local sel_desc="${DEV_DESCS[$sel_idx]}"
    local sel_id="${DEV_IDS[$sel_idx]}"
    local sel_group="${DEV_GROUPS[$sel_idx]}"

    msg_info "Selected: [${sel_type}] ${sel_desc} (${sel_slot}) in IOMMU Group ${sel_group}"

    # Check for companion multi-function devices on the same physical slot
    local slot_base="${sel_slot%.*}"
    declare -a ALL_IDS=("$sel_id")
    echo "Checking companion functions on slot ${slot_base}.*:"
    while IFS= read -r companion; do
        [[ -z "$companion" ]] && continue
        local c_slot="${companion%% *}"
        local c_desc="${companion#* }"
        local c_id=$(lspci -nns "$c_slot" | grep -o '\[[0-9a-fA-F]\{4\}:[0-9a-fA-F]\{4\}\]' | tail -n 1 | tr -d '[]')
        echo -e "  -> Found companion function: ${c_slot} [${c_id}] ${c_desc}"
        ALL_IDS+=("$c_id")
    done < <(lspci | grep "^${slot_base}\." | grep -v "^${sel_slot}")

    # Safeguard 3: Strict IOMMU Group Isolation Guard
    if [[ -d "/sys/kernel/iommu_groups/${sel_group}/devices" ]]; then
        local group_devs=$(find "/sys/kernel/iommu_groups/${sel_group}/devices/" -type l | wc -l)
        if ((group_devs > ${#ALL_IDS[@]})); then
            echo ""
            msg_err "DANGER: IOMMU Group ${sel_group} is NOT isolated! It contains ${group_devs} devices."
            echo "The following devices share this IOMMU group:"
            for dev in "/sys/kernel/iommu_groups/${sel_group}/devices/"*; do
                local d_name=$(basename "$dev")
                lspci -s "$d_name"
            done
            echo ""
            msg_warn "Passing through this device without an ACS override kernel patch will isolate ALL devices in this group."
            msg_warn "If critical host devices (storage, USB, network) are in this group, the host may lose access or crash."
            echo ""
            read -rp "Type 'I UNDERSTAND' to proceed with configuring this shared device, or press Enter to cancel: " confirm_shared
            if [[ "$confirm_shared" != "I UNDERSTAND" ]]; then
                msg_info "Setup cancelled. No configuration was modified."
                return 1
            fi
        else
            msg_ok "IOMMU Group ${sel_group} is fully isolated."
        fi
    fi

    # Suggested Profile Name based on classification
    local default_name=""
    if [[ "$sel_type" == "GPU" ]]; then
        default_name=$(echo "$sel_desc" | grep -o -E '(GTX|RTX|RX|Arc)?[[:space:]]*[0-9]{3,4}[[:space:]]*[A-Za-z0-9]*' | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || echo "gpu")
    elif [[ "$sel_type" == "NETWORK" ]]; then
        default_name=$(echo "$sel_desc" | grep -o -E '(10G|1G|Wi-Fi|Ethernet|[A-Za-z0-9]+)' | head -n 1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || echo "nic")
    elif [[ "$sel_type" == "USB" ]]; then
        default_name="usb-ctrl"
    elif [[ "$sel_type" == "STORAGE" ]]; then
        default_name="storage"
    else
        default_name="device"
    fi
    [[ -z "$default_name" ]] && default_name="passthrough"

    echo ""
    read -rp "Enter profile name [default: ${default_name}]: " profile_name
    profile_name="${profile_name:-$default_name}"
    profile_name=$(echo "$profile_name" | tr -cd 'a-zA-Z0-9_-')

    local default_desc="${sel_type} Passthrough ${profile_name}"
    read -rp "Enter profile description [default: ${default_desc}]: " profile_desc
    profile_desc="${profile_desc:-$default_desc}"

    local joined_ids
    joined_ids=$(IFS=','; echo "${ALL_IDS[*]}")

    mkdir -p "$CONFIG_DIR"
    local conf_file="${CONFIG_DIR}/${profile_name}.conf"

    cat <<EOF > "$conf_file"
# Passthrough Profile: ${profile_name}
# Generated by limine-vfio on $(date)
PROFILE="${profile_name}"
DEVICE_TYPE="${sel_type}"
DESCRIPTION="${profile_desc}"
PCI_IDS="${joined_ids}"
ENABLED="yes"
EOF

    msg_ok "Created profile configuration: ${conf_file}"

    # Configure Limine commandline entries in /etc/default/limine
    msg_info "Updating ${LIMINE_DEFAULT} with KERNEL_CMDLINE entries..."
    local raw_cmdline=""
    if [[ -f /etc/kernel/cmdline ]] && [[ -s /etc/kernel/cmdline ]]; then
        raw_cmdline=$(cat /etc/kernel/cmdline)
    elif [[ -f /proc/cmdline ]]; then
        raw_cmdline=$(cat /proc/cmdline)
    fi

    # Strip existing vfio and iommu parameters to prevent duplication
    local base_cmdline
    base_cmdline=$(echo "$raw_cmdline" | sed -E 's/(amd_iommu|intel_iommu|iommu|vfio-pci\.ids)=[^ ]*//g' | sed -E 's/  +/ /g' | xargs)

    # Detect or load IOMMU parameters
    local iommu_opts=""
    if [[ -f "$GLOBAL_CONFIG" ]]; then
        source "$GLOBAL_CONFIG"
    fi
    if [[ -n "$IOMMU_PARAMS" ]]; then
        iommu_opts="$IOMMU_PARAMS"
    elif grep -q "AuthenticAMD" /proc/cpuinfo 2>/dev/null; then
        iommu_opts="amd_iommu=on iommu=pt"
    elif grep -q "GenuineIntel" /proc/cpuinfo 2>/dev/null; then
        iommu_opts="intel_iommu=on iommu=pt"
    else
        iommu_opts="iommu=pt"
    fi
    local vfio_params="${iommu_opts} vfio-pci.ids=${joined_ids}"

    for kDir in /usr/lib/modules/*; do
        [[ -f "${kDir}/pkgbase" ]] || continue
        local kName=$(cat "${kDir}/pkgbase")
        kName="${kName// /}"
        local key="KERNEL_CMDLINE[${kName}-vfio-${profile_name}]"

        if grep -q "^${key}=" "$LIMINE_DEFAULT" 2>/dev/null; then
            sed -i "s|^${key}=.*|${key}=${base_cmdline} ${vfio_params}|" "$LIMINE_DEFAULT"
        else
            echo "${key}=${base_cmdline} ${vfio_params}" >> "$LIMINE_DEFAULT"
        fi
        msg_ok "Configured: ${key}"
    done

    # ONLY IF GPU AND NVIDIA: Prompt for driver exclusion
    if [[ "$sel_type" == "GPU" ]] && [[ "$sel_desc" =~ (NVIDIA|GeForce) ]]; then
        local pci_domain_bus="0000:${sel_slot}"
        echo ""
        read -rp "Is this GPU secondary (should it be excluded from host proprietary nvidia driver)? [Y/n]: " exclude_nvidia
        if [[ ! "$exclude_nvidia" =~ ^[Nn]$ ]]; then
            local modprobe_conf="/etc/modprobe.d/nvidia-utils.conf"
            mkdir -p /etc/modprobe.d
            if [[ -f "$modprobe_conf" ]] && grep -q 'NVreg_ExcludedGpus' "$modprobe_conf"; then
                if ! grep -q "$pci_domain_bus" "$modprobe_conf"; then
                    sed -i "s/NVreg_ExcludedGpus=/NVreg_ExcludedGpus=${pci_domain_bus},/" "$modprobe_conf"
                    msg_ok "Added ${pci_domain_bus} to ${modprobe_conf}"
                fi
            else
                echo "options nvidia NVreg_ExcludedGpus=${pci_domain_bus}" >> "$modprobe_conf"
                msg_ok "Configured ${pci_domain_bus} in ${modprobe_conf}"
            fi
        fi
    fi

    # Ensure automation hook is installed
    cmd_install_hook

    echo ""
    read -rp "Run limine-update now to generate boot entries? [Y/n]: " run_update
    if [[ ! "$run_update" =~ ^[Nn]$ ]]; then
        msg_info "Running limine-update..."
        limine-update
        msg_ok "Limine update completed!"
    fi
}

# ==============================================================================
# Remove Profile
# ==============================================================================
cmd_remove() {
    check_root
    msg_header "Remove VFIO Passthrough Profile"

    local target="${1:-}"

    if [[ -z "$target" ]]; then
        if [[ ! -d "$CONFIG_DIR" || -z $(ls -A "$CONFIG_DIR"/*.conf 2>/dev/null) ]]; then
            msg_err "No profiles found in ${CONFIG_DIR}."
            return 1
        fi

        declare -a PROFILES=()
        local idx=1
        for conf in "$CONFIG_DIR"/*.conf; do
            [[ -f "$conf" ]] || continue
            local pName=$(basename "$conf" .conf)
            PROFILES+=("$pName")
            echo "  [${idx}] ${pName} (${conf})"
            ((idx++))
        done

        read -rp "Select profile to remove [1-${#PROFILES[@]}]: " choice
        if [[ ! "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#PROFILES[@]})); then
            msg_err "Invalid selection."
            return 1
        fi

        target="${PROFILES[$((choice - 1))]}"
    fi

    target=$(basename "$target" .conf)
    if [[ ! -f "${CONFIG_DIR}/${target}.conf" ]]; then
        msg_err "Profile '${target}' not found in ${CONFIG_DIR}."
        return 1
    fi
    rm -f "${CONFIG_DIR}/${target}.conf"
    msg_ok "Removed ${CONFIG_DIR}/${target}.conf"

    # Remove from /etc/default/limine
    if [[ -f "$LIMINE_DEFAULT" ]]; then
        sed -i "/-vfio-${target}\]/d" "$LIMINE_DEFAULT"
        msg_ok "Cleaned up entries matching '-vfio-${target}' from ${LIMINE_DEFAULT}"
    fi

    read -rp "Run limine-update now to rebuild boot menu? [Y/n]: " run_update
    if [[ ! "$run_update" =~ ^[Nn]$ ]]; then
        limine-update
    fi
}

# ==============================================================================
# Generate Libvirt Hostdev XML
# ==============================================================================
cmd_generate_xml() {
    local target="${1:-}"
    msg_header "Libvirt Passthrough XML Generator"

    # If no target passed, prompt user to choose from existing profiles or raw device
    if [[ -z "$target" ]]; then
        declare -a PROFILES=()
        local idx=1
        echo "Available Passthrough Profiles:"
        if [[ -d "$CONFIG_DIR" && -n $(ls -A "$CONFIG_DIR"/*.conf 2>/dev/null) ]]; then
            for conf in "$CONFIG_DIR"/*.conf; do
                [[ -f "$conf" ]] || continue
                local pName=$(basename "$conf" .conf)
                PROFILES+=("$pName")
                echo "  [${idx}] Profile: ${pName} (${conf})"
                ((idx++))
            done
        fi
        if (( ${#PROFILES[@]} == 0 )); then
            msg_warn "No profiles found in ${CONFIG_DIR}."
            read -rp "Enter PCI bus address (e.g. 82:00.0) or profile name: " target
        else
            echo "  [m] Enter manual PCI address (e.g. 82:00.0)"
            read -rp "Select option [1-${#PROFILES[@]}, or m]: " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#PROFILES[@]})); then
                target="${PROFILES[$((choice - 1))]}"
            else
                read -rp "Enter PCI bus address (e.g. 82:00.0): " target
            fi
        fi
    fi

    [[ -z "$target" ]] && { msg_err "No profile or device specified."; return 1; }

    # Check if target is a profile file or profile name
    local conf_file=""
    if [[ -f "$target" ]]; then
        conf_file="$target"
    elif [[ -f "${CONFIG_DIR}/${target}.conf" ]]; then
        conf_file="${CONFIG_DIR}/${target}.conf"
    elif [[ -f "${CONFIG_DIR}/${target}" ]]; then
        conf_file="${CONFIG_DIR}/${target}"
    fi

    declare -a PCI_ADDRESSES=()
    local profile_title="${target}"
    local profile_desc=""

    if [[ -n "$conf_file" ]]; then
        local p_name="" p_ids=""
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key=$(echo "$key" | tr -d '[:space:]')
            val=$(echo "$val" | sed -e 's/^[[:space:]]*["'"'"']//' -e 's/["'"'"'][[:space:]]*$//')
            case "$key" in
                PROFILE|profile) p_name="$val" ;;
                DESCRIPTION|description) profile_desc="$val" ;;
                PCI_IDS|pci_ids) p_ids="$val" ;;
            esac
        done < "$conf_file"

        profile_title="${p_name:-$target}"
        IFS=',' read -ra ID_ARRAY <<< "$p_ids"
        for id in "${ID_ARRAY[@]}"; do
            id=$(echo "$id" | tr -d '[:space:]')
            [[ -z "$id" ]] && continue
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                local dev_addr=$(echo "$line" | awk '{print $1}')
                PCI_ADDRESSES+=("$dev_addr")
            done < <(lspci -d "$id" -D 2>/dev/null)
        done
    else
        # Direct PCI address
        local pci_raw="$target"
        [[ ! "$pci_raw" =~ ^[0-9a-fA-F]{4}: ]] && pci_raw="0000:${pci_raw}"

        # If device exists, include all devices in its IOMMU group so VM start succeeds
        local sysfs_group="/sys/bus/pci/devices/${pci_raw}/iommu_group/devices"
        if [[ -d "$sysfs_group" ]]; then
            for sib in "$sysfs_group"/*; do
                [[ -e "$sib" ]] && PCI_ADDRESSES+=("$(basename "$sib")")
            done
        else
            PCI_ADDRESSES+=("$pci_raw")
        fi
    fi

    # De-duplicate while preserving order
    declare -a UNIQUE_ADDRS=()
    declare -A SEEN_ADDRS=()
    for addr in "${PCI_ADDRESSES[@]}"; do
        if [[ -z "${SEEN_ADDRS[$addr]:-}" ]]; then
            SEEN_ADDRS["$addr"]=1
            UNIQUE_ADDRS+=("$addr")
        fi
    done
    PCI_ADDRESSES=("${UNIQUE_ADDRS[@]}")

    if (( ${#PCI_ADDRESSES[@]} == 0 )); then
        msg_err "No matching PCI devices found for: ${target}"
        return 1
    fi

    echo ""
    echo "<!-- ==================================================================== -->"
    echo "<!-- Libvirt Passthrough Hostdev XML for: ${profile_title} -->"
    [[ -n "$profile_desc" ]] && echo "<!-- Description: ${profile_desc} -->"
    echo "<!-- Paste this block into your domain XML using 'virsh edit <vm>'      -->"
    echo "<!-- or through Virtual Machine Manager (virt-manager) XML editor        -->"
    echo "<!-- ==================================================================== -->"
    echo ""

    for full_addr in "${PCI_ADDRESSES[@]}"; do
        local domain="${full_addr%%:*}"
        local remainder="${full_addr#*:}"
        local bus="${remainder%%:*}"
        local slot_fn="${remainder#*:}"
        local slot="${slot_fn%%.*}"
        local fn="${slot_fn#*.}"

        local dev_name
        dev_name=$(lspci -s "$full_addr" 2>/dev/null | sed "s/^[^ ]* //")

        echo "<!-- ${dev_name} (${full_addr}) -->"
        echo "<hostdev mode='subsystem' type='pci' managed='yes'>"
        echo "  <source>"
        echo "    <address domain='0x${domain}' bus='0x${bus}' slot='0x${slot}' function='0x${fn}'/>"
        echo "  </source>"
        echo "</hostdev>"
        echo ""
    done
}

# ==============================================================================
# Install / Setup
# ==============================================================================
cmd_install() {
    check_root
    msg_header "Installing limine-vfio & Limine Hook"

    # 1. Config directory
    mkdir -p "$CONFIG_DIR"
    msg_ok "Configuration directory ready at ${CONFIG_DIR}"

    # 2. Global config
    if [[ ! -f "$GLOBAL_CONFIG" && -f "${SCRIPT_DIR}/vfio-passthrough.conf.example" ]]; then
        cp "${SCRIPT_DIR}/vfio-passthrough.conf.example" "$GLOBAL_CONFIG"
        msg_ok "Installed global config template at ${GLOBAL_CONFIG}"
    fi

    # 3. Limine post-hook
    cmd_install_hook

    # 4. CLI executable symlink in /usr/local/bin
    mkdir -p /usr/local/bin
    ln -sf "${SCRIPT_DIR}/limine-vfio" /usr/local/bin/limine-vfio
    msg_ok "Installed CLI binary symlink at /usr/local/bin/limine-vfio"

    echo ""
    msg_ok "Setup complete! You can now run 'limine-vfio' directly from any terminal."
}

cmd_install_hook() {
    check_root
    msg_info "Deploying Limine post-hook to ${HOOK_TARGET}..."
    mkdir -p "$(dirname "$HOOK_TARGET")"
    cp "${SCRIPT_DIR}/95-vfio-entries" "$HOOK_TARGET"
    chmod +x "$HOOK_TARGET"
    msg_ok "Hook successfully installed at ${HOOK_TARGET}."
}

# ==============================================================================
# Help / Usage
# ==============================================================================
cmd_help() {
    echo -e "${BOLD}limine-vfio${RESET} (v${VERSION}) - Dynamic Device Passthrough Manager for Limine"
    echo ""
    echo -e "${BOLD}USAGE:${RESET}"
    echo "  limine-vfio <command> [arguments]"
    echo ""
    echo -e "${BOLD}COMMANDS:${RESET}"
    echo "  check          Run pre-flight checks (CPU virtualization, IOMMU, Limine, modules)"
    echo "  list-devices   Display all PCI devices, classifications, and IOMMU groups"
    echo "  status         Display current driver bindings, active cmdline, and configured profiles"
    echo "  add            Interactive wizard to discover, classify, and configure a new passthrough profile"
    echo "  remove         Interactive removal of an existing passthrough profile"
    echo "  generate-xml   Generate libvirt <hostdev> XML block for virt-manager/virsh"
    echo "  doctor         Check and automatically resolve boot menu and configuration conflicts"
    echo "  install        Deploy Limine hook, initialize /etc/vfio-passthrough.d, and link binary"
    echo "  help           Show this help message"
    echo ""
}

# ==============================================================================
# Main Entrypoint
# ==============================================================================
main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        check)        cmd_check "$@" ;;
        list-devices|list|devices) cmd_list_devices "$@" ;;
        status)       cmd_status "$@" ;;
        add)          cmd_add "$@" ;;
        remove)       cmd_remove "$@" ;;
        generate-xml|xml|virt-xml) cmd_generate_xml "$@" ;;
        doctor|fix|conflicts|check-conflicts) check_conflicts "yes" ;;
        install|install-hook|setup) cmd_install "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            msg_err "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
